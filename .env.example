# Copy this file to .env and fill in real values for local development.
# For production on Vercel, set the same variables under:
# Vercel Dashboard -> Project Settings -> Environment Variables -> redeploy.

# Required for the Gemini chatbot in the Playground (/api/chat).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for the contact form (/api/contact) to send email directly
# through your own Gmail account (no third-party form service).
#
# Setup (one-time):
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
#    (your normal Gmail password will NOT work here)
# 3. Fill in below (remove spaces from the 16-character app password):
GMAIL_USER=mubarijojo.ummah11@gmail.com
GMAIL_APP_PASSWORD=
