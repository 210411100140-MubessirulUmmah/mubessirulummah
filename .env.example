# Copy this file to .env and fill in real values for local development.
# For production on Vercel, set these same variables under:
# Vercel Dashboard -> Project Settings -> Environment Variables -> redeploy.

# Required for the Gemini chatbot in the Playground (/api/chat).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for the contact form (/api/contact) to actually deliver email.
# Get a free key at https://web3forms.com — IMPORTANT: after signing up,
# Web3Forms sends a confirmation link to your email. Submissions will not
# be delivered until that link is confirmed, even if the key itself is valid.
WEB3FORMS_ACCESS_KEY=
